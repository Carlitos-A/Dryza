---
import MainLayout from "../layouts/MainLayout.astro";
import Icon from "../shared/ui/Icon.astro";
---

<MainLayout
	title="Page Not Found | Dryza"
	description="The page you are looking for does not exist or is still under construction. Explore Dryza anti-moisture ceiling and wall panels from the homepage."
>
	<main
		class="relative flex min-h-svh items-center overflow-hidden bg-neutral-950 text-white"
	>
		{/* Halo rojo tenue: el mismo lenguaje visual que cierra la página
		    principal en la sección de beneficios. */}
		<div
			class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-1/2 bg-[radial-gradient(ellipse_at_center,color-mix(in_srgb,var(--color-primary-800)_45%,transparent),transparent_70%)]"
			aria-hidden="true"
		>
		</div>

		<div class="relative mx-auto w-full max-w-3xl px-6 py-24 text-center sm:py-32">
			<p
				class="text-xs font-semibold uppercase tracking-[0.28em] text-primary-300 sm:text-sm"
			>
				Error 404
			</p>

			<p
				class="mt-4 bg-linear-to-br from-primary-300 to-primary-500 bg-clip-text text-8xl font-extrabold tracking-tight text-transparent sm:text-9xl"
			>
				404
			</p>

			<h1 class="mt-6 text-3xl font-semibold tracking-tight sm:text-4xl">
				This area is still under construction
			</h1>

			<p
				class="mx-auto mt-4 max-w-xl text-base leading-7 text-white/70 sm:text-lg"
			>
				We are working hard to bring you this section. In the meantime,
				explore our anti-moisture ceiling and wall panels from the homepage.
			</p>

			<a
				href="/"
				class="group mt-10 inline-flex min-h-13 items-center gap-3 rounded-full bg-cta pl-7 pr-2.5 py-2.5 text-sm font-bold tracking-wide text-white shadow-lg shadow-cta/30 transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-cta-hover hover:shadow-xl hover:shadow-cta/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:text-base"
			>
				Back to homepage
				<span
					class="grid size-9 place-items-center rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5"
					aria-hidden="true"
				>
					<Icon name="arrow-right" class="size-5" />
				</span>
			</a>
		</div>
	</main>
</MainLayout>
