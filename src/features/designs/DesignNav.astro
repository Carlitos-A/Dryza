---
import Icon from "../../shared/ui/Icon.astro";
import PanelImage from "../../shared/ui/PanelImage.astro";
import { getPanelImage, type PanelDesign } from "./designs";

interface Props {
	prev: PanelDesign;
	next: PanelDesign;
}

const { prev, next } = Astro.props;

const links = [
	{ design: prev, label: "Previous design", direction: "prev" },
	{ design: next, label: "Next design", direction: "next" },
] as const;
---

<nav class="bg-neutral-950 text-white" aria-label="More panel designs">
	<div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:px-10 lg:py-20">
		<p
			data-animate
			style="--reveal-delay: 0ms;"
			class="text-center text-xs font-semibold uppercase tracking-[0.28em] text-primary-300 sm:text-sm"
		>
			Keep exploring
		</p>

		<div class="mt-8 grid gap-4 sm:grid-cols-2 sm:gap-6">
			{
				links.map(({ design, label, direction }, index) => (
					<a
						href={`/disenos/${design.slug}`}
						data-animate
						style={`--reveal-delay: ${(index + 1) * 90}ms;`}
						class={`design-nav-card group flex items-center gap-5 rounded-3xl border border-white/10 bg-white/5 p-5 transition duration-300 ease-out hover:-translate-y-1 hover:border-primary-500/50 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-300 sm:p-6 ${
							direction === "next" ? "sm:flex-row-reverse sm:text-right" : ""
						}`}
					>
						<span
							class="grid size-11 shrink-0 place-items-center rounded-full border border-white/15 text-white/70 transition duration-300 group-hover:border-primary-400 group-hover:text-primary-200"
							aria-hidden="true"
						>
							<Icon
								name="arrow-right"
								class={`size-5 transition-transform duration-300 ${
									direction === "prev"
										? "rotate-180 group-hover:-translate-x-0.5"
										: "group-hover:translate-x-0.5"
								}`}
							/>
						</span>

						<span class="min-w-0 flex-1">
							<span class="block text-xs font-semibold uppercase tracking-[0.2em] text-white/60 transition-colors duration-300 group-hover:text-primary-200">
								{label}
							</span>
							<span class="mt-1 block truncate text-xl font-semibold text-white sm:text-2xl">
								{design.name}
							</span>
						</span>

						<span
							class="hidden w-20 shrink-0 overflow-hidden rounded-2xl bg-linear-to-b from-neutral-900 to-neutral-950 p-1.5 sm:block"
							aria-hidden="true"
						>
							<PanelImage
								src={getPanelImage(design.slug)}
								alt=""
								fit="contain"
								class="aspect-4/3 transition-transform duration-500 group-hover:scale-105"
							/>
						</span>
					</a>
				))
			}
		</div>
	</div>
</nav>

<script>
	import "../../shared/ui/revealOnScroll";
</script>

<style>
	/* Reveal vertical, igual que la sección de historia. */
	[data-animate] {
		opacity: 0;
		transform: translateY(1.5rem);
		transition:
			opacity 0.7s ease-out,
			transform 0.7s ease-out;
		transition-delay: var(--reveal-delay, 0ms);
		will-change: opacity, transform;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: none;
	}

	@supports (animation-timeline: view()) {
		[data-animate] {
			opacity: 1;
			transform: none;
			transition: none;
			animation: design-nav-reveal linear both;
			animation-timeline: view();
			animation-range: entry 10% cover 30%;
		}
	}

	@keyframes design-nav-reveal {
		from {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		[data-animate] {
			opacity: 1;
			transform: none;
			transition: none;
			animation: none;
		}

		.design-nav-card,
		.design-nav-card :global(svg),
		.design-nav-card :global(img) {
			transition: none;
		}

		.design-nav-card:hover {
			transform: none;
		}
	}
</style>
