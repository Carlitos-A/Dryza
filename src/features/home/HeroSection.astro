---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import heroTerrace from "../../assets/images/hero-terrace.png";
import heroPool from "../../assets/images/hero-pool.png";
import Icon from "../../shared/ui/Icon.astro";

// Recorrido editorial del hero: cada entrada es una diapositiva del fondo.
// Las fotos se resuelven por convención: suelta un archivo nombrado con la
// `key` (ej. `framing.jpg`) en src/assets/images/hero-slides/ y reemplaza el
// fallback sin tocar código — la carpeta puede no existir todavía.
const heroSlides = [
	{ key: "framing", number: "01", label: "Framing" },
	{ key: "drywall", number: "02", label: "Drywall" },
	{ key: "finishing", number: "03", label: "Finishing" },
	{ key: "ceilings", number: "04", label: "Ceilings" },
	{ key: "details", number: "05", label: "Details" },
	{ key: "final-finish", number: "06", label: "Final Finish" },
];

const heroSlideImages = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/images/hero-slides/*.{png,jpg,jpeg,webp,avif}",
	{ eager: true },
);

// Mientras no haya fotografía dedicada de cada etapa, las diapositivas rotan
// entre las dos fotos reales del sitio.
const heroFallbacks: ImageMetadata[] = [heroTerrace, heroPool];

function getHeroSlideImage(key: string, index: number): ImageMetadata {
	const match = Object.entries(heroSlideImages).find(([path]) => {
		const filename = path.split("/").pop() ?? "";
		return filename.replace(/\.[^.]+$/, "") === key;
	});

	if (match) return match[1].default;

	return heroFallbacks[index % heroFallbacks.length];
}

// La fotografía del hero se sirve en AVIF/WebP con srcset: el PNG original
// pesa ~2.4 MB y sería un LCP innecesariamente caro.
---

<section
	id="inicio"
	class="relative isolate flex min-h-svh overflow-hidden bg-neutral-950 text-white"
	aria-labelledby="hero-title"
	data-hero
>
	<div class="absolute inset-0 -z-20" aria-hidden="true">
		{
			heroSlides.map((slide, index) => (
				<div
					class="absolute inset-0"
					data-hero-slide
					data-active={index === 0 ? "true" : undefined}
				>
					<Image
						src={getHeroSlideImage(slide.key, index)}
						alt=""
						widths={[768, 1280, 1600, 1874]}
						sizes="100vw"
						formats={["avif", "webp"]}
						loading="eager"
						fetchpriority={index === 0 ? "high" : "auto"}
						class="hero-bg h-full w-full object-cover"
					/>
				</div>
			))
		}
	</div>

	<div
		class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(12,9,10,0.62)_0%,rgba(12,9,10,0.28)_38%,rgba(12,9,10,0.55)_72%,rgba(12,9,10,0.92)_100%)]"
		aria-hidden="true"
	>
	</div>

	<div
		class="mx-auto flex w-full max-w-7xl flex-1 flex-col justify-center px-5 pb-10 pt-32 sm:px-8 sm:pb-12 sm:pt-36 lg:px-12 lg:pb-50"
	>
		<div
			class="max-w-6xl justify-center text-center lg:mx-auto lg:max-w-6xl"
		>
			<p
				class="hero-enter flex justify-center items-center gap-3 text-xs font-semibold uppercase tracking-[0.24em] text-white/80 sm:text-sm"
				style="--enter-delay: 0ms;"
			>
				Interior Construction &amp; Finishing
			</p>

			<h1
				id="hero-title"
				class="hero-enter mt-5 text-balance drop-shadow-sm"
				style="--enter-delay: 100ms;"
			>
				<span class="block font-serif text-4xl sm:text-4xl lg:text-4xl xl:text-7xl">
					Built from
				</span>
				<span
					class="block text-7xl font-extrabold uppercase text-primary-300 sm:text-6xl lg:text-7xl xl:text-8xl"
					style="--enter-delay: 300ms;"
				>
					frame to finish.
				</span>
			</h1>

			<p
				class="hero-enter mt-2 justify-center text-center text-base text-white/80"
				style="--enter-delay: 180ms;"
			>
				<span class="font-bold max-w-4xl"
					>Complete interior construction and finishing</span
				><br />
				<span class="block max-w-2xl mx-auto"
					>From framing and drywall installation to ceilings, repairs,
					painting, and the details that bring every space together.</span
				>
			</p>

			<div
				class="hero-enter mt-10 flex items-center justify-center gap-4"
				style="--enter-delay: 270ms;"
			>
				<a
					href="/contacto"
					class="inline-flex min-h-13 items-center gap-3 border rounded-full border-white px-6 text-sm font-bold uppercase tracking-wide text-white/90 transition-[background-color,border-color,color] duration-300 ease-out hover:border-primary-500 hover:bg-primary-hover hover:text-primary-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-200 motion-reduce:transition-none sm:text-base"
				>
					Start a Project
				</a>

				<a
					href="/services"
					class="group inline-flex min-h-13 items-center gap-3 rounded-full bg-cta pl-7 pr-2.5 py-2.5 text-sm font-bold uppercase tracking-wide text-white shadow-lg shadow-cta/30 transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-cta-hover hover:shadow-xl hover:shadow-cta/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:text-base"
				>
					View Our Services
					<span
						class="grid size-9 place-items-center rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5"
						aria-hidden="true"
					>
						<Icon name="arrow-right" class="size-5" />
					</span>
				</a>
			</div>
		</div>


		<nav
			class="hero-enter mt-10 pt-12 sm:absolute sm:inset-x-0 sm:bottom-0 sm:mt-0 sm:px-8 sm:pb-10 sm:pt-12 lg:px-20 lg:pb-12"
			style="--enter-delay: 360ms;"
			aria-label="Construction stages"
		>
			<div class="mx-auto max-w-7xl">
				<ol
					class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 border-t border-white/15 pt-5"
				>
				{
					heroSlides.map((slide, index) => (
						<li>
							<button
								type="button"
								class="group relative flex cursor-pointer items-baseline gap-2.5 pb-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.2em] sm:text-xs"
								data-hero-tab
								data-active={index === 0 ? "true" : undefined}
								aria-current={index === 0 ? "true" : undefined}
							>
								<span class="hero-tab-number">{slide.number}</span>
								<span>{slide.label}</span>
								<span
									class="hero-tab-line absolute inset-x-0 bottom-0 h-px"
									aria-hidden="true"
								/>
							</button>
						</li>
					))
				}
			</ol>
			</div>
		</nav>
	</div>
</section>

<script>
	const hero = document.querySelector<HTMLElement>("[data-hero]");

	if (hero) {
		const slides = Array.from(
			hero.querySelectorAll<HTMLElement>("[data-hero-slide]"),
		);
		const tabs = Array.from(
			hero.querySelectorAll<HTMLButtonElement>("[data-hero-tab]"),
		);
		const reducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		const SLIDE_DURATION = 3000;

		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		const activate = (index: number) => {
			current = index;
			slides.forEach((slide, i) => {
				if (i === index) slide.setAttribute("data-active", "true");
				else slide.removeAttribute("data-active");
			});
			tabs.forEach((tab, i) => {
				if (i === index) {
					tab.setAttribute("data-active", "true");
					tab.setAttribute("aria-current", "true");
				} else {
					tab.removeAttribute("data-active");
					tab.removeAttribute("aria-current");
				}
			});
		};

		const stop = () => {
			if (timer) clearInterval(timer);
			timer = undefined;
		};

		const play = () => {
			stop();
			if (reducedMotion || slides.length < 2) return;
			timer = setInterval(
				() => activate((current + 1) % slides.length),
				SLIDE_DURATION,
			);
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => {
				activate(index);
				play();
			});
		});


		play();
	}
</script>

<style>
	.hero-enter {
		animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
		animation-delay: var(--enter-delay, 0ms);
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translateY(1.75rem);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	[data-hero-slide] {
		opacity: 0;
		transition: opacity 1.1s ease-in-out;
	}

	[data-hero-slide][data-active="true"] {
		opacity: 1;
	}


	.hero-bg {
		animation: hero-settle 2.4s ease-out both;
	}

	@keyframes hero-settle {
		from {
			transform: scale(1.06);
		}
		to {
			transform: none;
		}
	}

	/* Índice de servicios: la etapa activa se ilumina. */
	[data-hero-tab] {
		color: rgb(255 255 255 / 0.45);
		transition: color 0.3s ease-out;
	}

	[data-hero-tab]:hover {
		color: rgb(255 255 255 / 0.85);
	}

	[data-hero-tab]:focus-visible {
		outline: 2px solid var(--color-primary-200);
		outline-offset: 4px;
	}

	.hero-tab-number {
		color: rgb(255 255 255 / 0.35);
		transition: color 0.3s ease-out;
	}

	[data-hero-tab][data-active="true"] {
		color: #fff;
	}

	[data-hero-tab][data-active="true"] .hero-tab-number {
		color: var(--color-primary-300);
	}

	/* Línea de progreso bajo la etapa activa; sigue el ritmo del slider. */
	.hero-tab-line {
		background: rgb(255 255 255 / 0.18);
	}

	.hero-tab-line::after {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--color-primary-300);
		transform: scaleX(0);
		transform-origin: left;
	}

	[data-hero-tab][data-active="true"] .hero-tab-line::after {
		animation: hero-tab-progress 3s linear forwards;
	}


	@keyframes hero-tab-progress {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-enter,
		.hero-bg {
			animation: none;
		}

		[data-hero-slide] {
			transition: none;
		}

		.hero-tab-line::after {
			animation: none;
		}

		[data-hero-tab][data-active="true"] .hero-tab-line::after {
			transform: scaleX(1);
		}
	}
</style>
