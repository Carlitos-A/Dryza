---
import heroPool from "../../assets/images/hero-pool.png";
import heroRestaurant from "../../assets/images/hero-terrace.png";
import escala from "../../assets/images/test1.jpg";

const slides = [
	{
		src: escala,
		alt: "Escala de imagenes que iran en el hero",
	},
	{
		src: heroPool,
		alt: "Piscina interior con cielos y muros resistentes a la humedad",
	},
	{
		src: heroRestaurant,
		alt: "Restaurante contemporáneo con cielo modular y revestimiento decorativo",
	},
];
---

<section
	id="inicio"
	class="relative isolate flex min-h-svh overflow-hidden bg-neutral-950 text-white"
	aria-labelledby="hero-title"
	data-hero
>
	<div class="absolute inset-0 -z-20" aria-hidden="true">
		{
			slides.map((slide, index) => (
				<img
					src={slide.src.src}
					alt=""
					width={slide.src.width}
					height={slide.src.height}
					loading={index === 0 ? "eager" : "lazy"}
					fetchpriority={index === 0 ? "high" : "auto"}
					class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 ease-out data-[active=true]:opacity-100"
					data-hero-slide
					data-active={index === 0 ? "true" : "false"}
				/>
			))
		}
	</div>

	<div
		class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(12,9,10,0.48)_0%,rgba(12,9,10,0.18)_34%,rgba(12,9,10,0.42)_67%,rgba(12,9,10,0.78)_100%)]"
		aria-hidden="true"
	>
	</div>

	<div
		class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-48 bg-linear-to-b from-transparent to-neutral-950 sm:h-56"
		aria-hidden="true"
	>
	</div>

	<div
		class="mx-auto flex w-full max-w-7xl flex-1 items-center px-5 pb-24 pt-32 sm:px-8 sm:pb-28 sm:pt-36 lg:px-10 lg:pb-24"
	>
		<div class="mx-auto flex max-w-5xl flex-col items-center text-center">
			<p
				class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.24em] text-white/80 sm:text-sm"
			>
				<span class="h-px w-7 bg-primary-300"></span>
				Decorative Anti-Moisture Panels
				<span class="h-px w-7 bg-primary-300"></span>
			</p>

			<h1
				id="hero-title"
				class="text-balance text-4xl font-semibold leading-[1.04] tracking-[-0.035em] drop-shadow-sm sm:text-5xl md:text-6xl lg:text-7xl"
			>
				Beautiful Interiors.<br class="hidden sm:block" />
				Zero Moisture Problems.
			</h1>

			<p
				class="mt-6 max-w-2xl text-pretty text-base leading-7 text-white/80 sm:text-lg sm:leading-8 md:text-xl"
			>
				Premium Ceiling Panels That Eliminate Moisture While
				Transforming Your Space.
			</p>

			<a
				href="#contacto"
				class="group relative mt-9 inline-flex min-h-13 items-center gap-3 overflow-hidden rounded-full bg-cta pl-7 pr-2.5 py-2.5 text-sm font-bold tracking-wide text-white shadow-lg shadow-cta/30 ring-1 ring-white/15 transition duration-300 ease-out hover:-translate-y-0.5 hover:bg-cta-hover hover:shadow-xl hover:shadow-cta/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white sm:text-base"
			>
				<span
					class="pointer-events-none absolute inset-0 -translate-x-full bg-linear-to-r from-transparent via-white/25 to-transparent transition-transform duration-700 ease-out group-hover:translate-x-full"
					aria-hidden="true"
				></span>
				Get Your Free Quote
				<span
					class="grid size-9 place-items-center rounded-full bg-white/15 transition-transform duration-300 group-hover:translate-x-0.5"
					aria-hidden="true"
				>
					<svg
						viewBox="0 0 20 20"
						class="size-5 fill-none"
						stroke="currentColor"
						stroke-width="1.8"
					>
						<path d="M4 10h12M11 5l5 5-5 5"></path>
					</svg>
				</span>
			</a>
		</div>
	</div>

	<div
		class="absolute inset-x-0 bottom-6 flex px-5 sm:bottom-8 sm:px-8 lg:px-10"
	>
		<div
			class="flex items-center gap-4"
			aria-label="Seleccionar imagen del hero"
		>
			<span
				class="text-xs font-semibold tabular-nums text-white/75"
				data-slide-count>01 / 03</span
			>
			<div class="flex gap-2">
				{
					slides.map((slide, index) => (
						<button
							type="button"
							class="group grid h-8 w-8 place-items-center"
							aria-label={`Mostrar imagen ${index + 1}: ${slide.alt}`}
							aria-current={index === 0 ? "true" : "false"}
							data-slide-button
							data-slide-index={index}
						>
							<span class="h-0.5 w-full bg-white/35 transition-all group-hover:bg-white/70 group-aria-current:bg-white" />
						</button>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	const hero = document.querySelector<HTMLElement>("[data-hero]");

	if (hero) {
		const slides = Array.from(
			hero.querySelectorAll<HTMLElement>("[data-hero-slide]"),
		);
		const buttons = Array.from(
			hero.querySelectorAll<HTMLButtonElement>("[data-slide-button]"),
		);
		const count = hero.querySelector<HTMLElement>("[data-slide-count]");
		const reduceMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;
		let current = 0;
		let timer: number | undefined;

		const showSlide = (next: number) => {
			current = (next + slides.length) % slides.length;

			slides.forEach((slide, index) => {
				slide.dataset.active = String(index === current);
			});

			buttons.forEach((button, index) => {
				button.setAttribute("aria-current", String(index === current));
			});

			if (count) {
				count.textContent = `${String(current + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
			}
		};

		const stopRotation = () => window.clearInterval(timer);
		const startRotation = () => {
			if (!reduceMotion && slides.length > 1) {
				stopRotation();
				timer = window.setInterval(() => showSlide(current + 1), 3000);
			}
		};

		buttons.forEach((button) => {
			button.addEventListener("click", () => {
				showSlide(Number(button.dataset.slideIndex));
				startRotation();
			});
		});

		startRotation();
	}
</script>
