---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "./Icon.astro";

interface Props {
	src?: ImageMetadata;
	alt: string;
	class?: string;
	/** How the transparent panel render fills its frame. */
	fit?: "cover" | "contain";
}

const { src, alt, class: className = "", fit = "cover" } = Astro.props;
const objectFit = fit === "contain" ? "object-contain" : "object-cover";
const imageClass = `h-full w-full ${objectFit} ${className}`;
// SVGs are vector and gain nothing from Astro's image optimization (which also
// requires Sharp). Serve them with a plain <img>; keep <Image> for raster files.
const isSvg = src?.format === "svg";
---

{
	src ? (
		isSvg ? (
			<img
				src={src.src}
				alt={alt}
				width={src.width}
				height={src.height}
				loading="lazy"
				decoding="async"
				class={imageClass}
			/>
		) : (
			<Image src={src} alt={alt} class={imageClass} />
		)
	) : (
		<div
			role="img"
			aria-label={alt}
			class={`flex h-full w-full flex-col items-center justify-center gap-2 bg-linear-to-br from-primary-900 via-primary-950 to-neutral-950 text-primary-200/80 ${className}`}
		>
			<Icon name="image-placeholder" class="size-8 opacity-70" />
			<span class="text-[0.65rem] font-semibold uppercase tracking-[0.2em]">
				Image coming soon
			</span>
		</div>
	)
}
