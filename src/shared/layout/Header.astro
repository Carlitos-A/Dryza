---
const navItems = [
	{ href: "#paneles", label: "Paneles" },
	{ href: "#revestimientos", label: "Revestimientos" },
	{ href: "#beneficios", label: "Beneficios" },
	{ href: "#contacto", label: "Contacto" },
	{ href: "#tecnologia", label: "Tecnologia" },
	{ href: "#about", label: "About" },
];

---

<header id=header class="sticky top-0 z-50 bg-white">
	<div class="mx-auto flex w-full items-center px-4 sm:px-6 lg:px-8">
		<a href="/" aria-label="Ir al inicio de Dryza" class="shrink-0">
			<img
				src="/icon.svg"
				alt="Logo de Dryza"
				class="h-20 w-auto md:h-25"
			/>
		</a>

		<div class="ml-auto hidden items-center gap-20 md:flex">
			<nav
				class="flex items-center gap-10 text-base font-medium"
				aria-label="Navegacion principal"
			>
				{
					navItems.map((item) => (
						<a
							class="transition hover:text-primary-hover"
							href={item.href}
						>
							{item.label}
						</a>
					))
				}
			</nav>

			<a
				href="#contacto"
				class="inline-flex min-h-10 items-center justify-center rounded-md bg-cta px-4 text-sm font-bold text-white transition hover:bg-cta-hover"
			>
				Cotizar
			</a>
		</div>

		<button
			type="button"

			class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-md text-primary transition hover:border-primary-200 hover:bg-primary-50 md:hidden cursor-pointer"
			aria-label="Abrir menu de navegacion"
			aria-controls="mobile-menu"
			aria-expanded="false"
			data-menu-button
		>
			<span class="sr-only">Abrir menu</span>	
			<span class="flex w-5 flex-col gap-1.5">
				<span class="h-0.5 rounded-full bg-current"></span>
				<span class="h-0.5 rounded-full bg-current"></span>
				<span class="h-0.5 w-3 rounded-full bg-current"></span>
			</span>
		</button>
	</div>

	<div
		id="mobile-menu"
		class="hidden bg-white md:hidden"
		data-mobile-menu
	>
		<nav
			class="flex flex-col text-base font-medium text-center sm:px-6"
			aria-label="Navegacion principal movil"
		>
			{
				navItems.map((item) => (
					<a
						class="rounded-md px-3 py-3 transition hover:bg-primary-50 hover:text-primary-hover"
						href={item.href}
					>
						{item.label}
					</a>
				))
			}

			<a
				href="#contacto"
				class="mt-3 inline-flex min-h-11 items-center justify-center rounded-md bg-cta px-4 text-sm font-bold text-white transition hover:bg-cta-hover"
			>
				Cotizar
			</a>
		</nav>
	</div>
</header>

<script>
	const menuButton = document.querySelector("[data-menu-button]");
	const mobileMenu = document.querySelector("[data-mobile-menu]");

	menuButton?.addEventListener("click", () => {
		const isOpen = menuButton.getAttribute("aria-expanded") === "true";

		menuButton.setAttribute("aria-expanded", String(!isOpen));
		menuButton.setAttribute(
			"aria-label",
			isOpen ? "Abrir menu de navegacion" : "Cerrar menu de navegacion",
		);
		mobileMenu?.classList.toggle("hidden", isOpen);
	});

	mobileMenu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menuButton?.setAttribute("aria-expanded", "false");
			menuButton?.setAttribute("aria-label", "Abrir menu de navegacion");
			mobileMenu.classList.add("hidden");
		});
	});
</script>

